# ==============================================================================
# BRIDGEA ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilainya: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Aplikasi & Server Flask
# ------------------------------------------------------------------------------
SECRET_KEY=ganti_dengan_kunci_rahasia_acak_yang_panjang_dan_aman
PORT=8080
FLASK_ENV=production
FLASK_DEBUG=0

# ------------------------------------------------------------------------------
# 2. Konfigurasi AI Service (Primary: OpenAI, Secondary Fallback: Gemini)
# ------------------------------------------------------------------------------
# API Key OpenAI atau penyedia OpenAI-compatible (Wajib jika ingin menggunakan AI OpenAI)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL OpenAI-compatible (Opsional).
# Kosongkan untuk menggunakan endpoint resmi OpenAI (https://api.openai.com/v1).
# Atau arahkan ke proxy/gateway pihak ketiga, misal: https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Model OpenAI yang digunakan (Default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Timeout pemanggilan AI dalam detik (Default: 30)
AI_TIMEOUT=30

# API Key Google Gemini untuk secondary fallback jika OpenAI gagal/tidak disetel (Opsional)
GEMINI_API_KEY=

# Model Google Gemini (Default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. Konfigurasi Firebase
# ------------------------------------------------------------------------------
# URL Firebase Realtime Database
FIREBASE_DATABASE_URL=https://bridgesign-default-rtdb.firebaseio.com/

# Storage Bucket Firebase
FIREBASE_STORAGE_BUCKET=bridgesign.firebasestorage.app

# Path file Service Account JSON Firebase (jika tidak berada di root direktori)
# GOOGLE_APPLICATION_CREDENTIALS=firebase-credentials.json

# ------------------------------------------------------------------------------
# 4. Layanan Eksternal (WhatsApp Gateway & STT)
# ------------------------------------------------------------------------------
# Token API Fonnte untuk notifikasi WhatsApp
FONNTE_API_TOKEN=

# API Key Deepgram untuk Speech-to-Text realtime
DEEPGRAM_API_KEY=
